# macOS
.DS_Store

# Project artifacts (large or generated)
*.png
# Ignore everything under data/ ...
data/**
# ... but descend into its directories so the exception below can match ...
!data/**/
# ... and keep provenance/docs that explain where the (untracked) data came from.
!data/**/SOURCE.md
# ... and keep the small, static, REDISTRIBUTABLE tables the package needs to load
# and pass its tests on a fresh clone / CI (MT-CKD continua + the AFGL reference
# profiles; ~0.6 MB, never-changing release snapshots).
#
# The HITRAN CIA tables are deliberately NOT here: HITRAN's terms forbid
# redistribution, so `download_data()` fetches them at runtime into a Scratch space
# (see src/Utils/datasets.jl and data/cia/SOURCE.md). The bulk data (line lists,
# line-mixing, broadening, LBLRTM refs) stays ignored for size reasons.
!data/afgl_us_standard_50lev.csv
!data/afgl_tropical_50lev.csv
!data/afgl_midlatitude_summer_50lev.csv
!data/afgl_midlatitude_winter_50lev.csv
!data/afgl_subarctic_summer_50lev.csv
!data/afgl_subarctic_winter_50lev.csv
!data/mt_ckd_h2o/mt_ckd43_h2o_coeffs.csv
!data/mt_ckd_co2/mt_ckd_co2_coeffs.csv

# Stray history files
.Rhistory

# Python: bytecode caches
__pycache__/
*.py[cod]

# Julia: code coverage
*.jl.cov
*.jl.*.cov

# Julia: allocation tracking
*.jl.mem

# Julia: legacy BinDeps build artifacts
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Julia: Documenter.jl output
docs/build/
docs/site/

# Large reference PDFs kept locally for reference (e.g. thesis), not in history.
docs/*.pdf

# Note: Manifest.toml is intentionally tracked to lock the dependency
# snapshot behind the ARTS-validation results. Untrack once the package
# is registered to General.
